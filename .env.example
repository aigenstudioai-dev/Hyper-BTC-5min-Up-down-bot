# ─── Wallet ────────────────────────────────────────────────────────────────────
# Polygon private key (no 0x prefix needed; the bot handles it)
PRIVATE_KEY=your_polygon_private_key_here

# ─── Polymarket CLOB L2 Credentials ────────────────────────────────────────────
# Obtain these by calling POST /auth/api-key with your L1 wallet signature.
# Run: python bot.py --derive-api-key  to generate them automatically.
POLY_API_KEY=your_polymarket_api_key
POLY_API_SECRET=your_polymarket_api_secret
POLY_API_PASSPHRASE=your_polymarket_api_passphrase

# ─── RPC / Network ─────────────────────────────────────────────────────────────
POLYGON_RPC=https://polygon-rpc.com
# Optional: use a private RPC for lower latency (e.g. Alchemy, Infura)
# POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── Polymarket API Base URLs ──────────────────────────────────────────────────
CLOB_BASE_URL=https://clob.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com

# ─── Pyth Network ──────────────────────────────────────────────────────────────
PYTH_HERMES_URL=https://hermes.pyth.network

# ─── Strategy Knobs ────────────────────────────────────────────────────────────
# Kelly fraction (0.25 = quarter-Kelly, conservative)
KELLY_FRACTION=0.25
# Maximum single-trade USDC notional
MAX_POSITION_USDC=500
# Starting bankroll in USDC
BANKROLL_USDC=300
# Maximum allowed drawdown before the bot halts (0–1)
MAX_DRAWDOWN=0.15
# Minimum Window Delta % to trigger a STRONG_BUY signal
SIGNAL_THRESHOLD_PCT=0.08
# Seconds before window close to evaluate the signal
ENTRY_WINDOW_SECONDS=45
# Seconds to wait for a limit order fill before cancel-replace
ORDER_TIMEOUT_SECONDS=5

# ─── Mode ──────────────────────────────────────────────────────────────────────
# Set to "true" to paper-trade without spending real USDC
SIMULATION_MODE=true
