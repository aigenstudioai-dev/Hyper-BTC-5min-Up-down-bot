# ─── Wallet ────────────────────────────────────────────────────────────────────
# Polygon private key (no 0x prefix needed; the bot handles it).
# Leave this EMPTY for paper-trading (python bot.py) — a safe placeholder
# wallet is generated automatically. Only required for --live.
PRIVATE_KEY=

# ─── Polymarket CLOB L2 Credentials ────────────────────────────────────────────
# Obtain these by calling POST /auth/api-key with your L1 wallet signature.
# Run: python bot.py --derive-api-key  to generate them automatically.
POLY_API_KEY=your_polymarket_api_key
POLY_API_SECRET=your_polymarket_api_secret
POLY_API_PASSPHRASE=your_polymarket_api_passphrase

# ─── RPC / Network ─────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
# Optional: use a private RPC for lower latency (e.g. Alchemy, Infura)
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── Collateral (approve_usdc.py) ──────────────────────────────────────────────
# CLOB V2 settles in pUSD, not USDC.e directly. approve_usdc.py handles the
# full setup: approve the Onramp for USDC.e, optionally wrap some into pUSD
# (--wrap AMOUNT), and approve the Exchange for pUSD.
#
# USDC.e (Bridged USDC) — what you actually hold and wrap from.
# Switch to native USDC if Polymarket migrates:
# USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# pUSD (Polymarket USD) — the actual CLOB V2 settlement/collateral token.
PUSD_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
# Collateral Onramp — wraps USDC.e into pUSD.
COLLATERAL_ONRAMP_ADDRESS=0x93070a847efEf7F70739046A929D47a521F5B8ee

# ─── Polymarket API Base URLs ──────────────────────────────────────────────────
CLOB_BASE_URL=https://clob.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com

# ─── Pyth Network ──────────────────────────────────────────────────────────────
PYTH_HERMES_URL=https://hermes.pyth.network

# ─── Strategy Knobs ────────────────────────────────────────────────────────────
# Kelly fraction (0.25 = quarter-Kelly, conservative)
KELLY_FRACTION=0.25
# Maximum single-trade USDC notional
MAX_POSITION_USDC=500
# Starting bankroll in USDC
BANKROLL_USDC=300
# Maximum allowed drawdown before the bot halts (0–1)
MAX_DRAWDOWN=0.15
# Minimum Window Delta % to trigger a STRONG_BUY signal
SIGNAL_THRESHOLD_PCT=0.08
# Seconds before window close to evaluate the signal
ENTRY_WINDOW_SECONDS=45
# Seconds to wait for a limit order fill before cancel-replace
ORDER_TIMEOUT_SECONDS=5

# ─── Notifications (optional) ──────────────────────────────────────────────────
# Leave blank to disable that channel.  Both can be set simultaneously.
#
# Telegram:
#   1. Create a bot via @BotFather and copy its token.
#   2. Send a message to the bot, then get your chat ID from:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Discord:
#   Channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ─── Mode ──────────────────────────────────────────────────────────────────────
# Set to "true" to paper-trade without spending real USDC
SIMULATION_MODE=true
